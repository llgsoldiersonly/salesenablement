# Copy this file to `.env` (same directory) and fill in your keys.
# `.env` is gitignored — never commit it.

# Google Places API (New) — https://developers.google.com/maps/documentation/places/web-service
# Without this, places.ts returns mock data.
GOOGLE_PLACES_API_KEY=

# SerpAPI — https://serpapi.com/
# Without this, serp.ts returns mock data.
SERPAPI_KEY=
