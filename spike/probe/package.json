{
  "name": "llg-probe-spike",
  "version": "0.1.0",
  "private": true,
  "description": "Data-source spike for the LLG opener brief. Validates whether we can pull useful, structured data from a law firm's public footprint in <60s.",
  "type": "module",
  "scripts": {
    "probe": "node --env-file-if-exists=.env --import tsx src/probe.ts",
    "batch": "node --env-file-if-exists=.env --import tsx src/batch.ts",
    "brief": "node --env-file-if-exists=.env --import tsx src/brief-generator.ts",
    "test:fixture": "node --import tsx src/test-fixture.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "cheerio": "^1.0.0",
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
